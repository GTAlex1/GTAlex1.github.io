rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function esAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/administradores/$(request.auth.uid)).data.activo == true;
    }

    match /administradores/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }

    match /jugadores/{id} {
      allow create: if true;
      allow read, update, delete: if esAdmin();
    }

    match /captaciones/{id} {
      allow get: if esAdmin() || resource.data.abierta == true;
      allow list: if esAdmin();
      allow create, update: if esAdmin()
        && request.resource.data.keys().hasOnly(['nombre', 'abierta'])
        && request.resource.data.nombre is string
        && texto(request.resource.data.nombre, 1, 100)
        && request.resource.data.abierta is bool;

      match /inscripciones/{registro} {
        allow read: if esAdmin();
        allow create: if get(/databases/$(database)/documents/captaciones/$(id)).data.abierta == true
          && inscripcionValida();
      }
    }

    function texto(valor, minimo, maximo) {
      return valor is string && valor.size() >= minimo && valor.size() <= maximo;
    }

    function inscripcionValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nombre', 'telefono', 'edad', 'pierna', 'altura', 'peso',
        'posicion', 'equipo_anterior', 'notas', 'foto', 'fechaRegistro'])
        && texto(d.nombre, 1, 120) && texto(d.telefono, 1, 40)
        && d.edad is int && d.edad >= 16 && d.edad <= 120
        && texto(d.pierna, 1, 40) && texto(d.posicion, 1, 80)
        && d.altura is int && d.altura > 0 && d.altura <= 300
        && d.peso is number && d.peso > 0 && d.peso <= 500
        && texto(d.equipo_anterior, 0, 120) && texto(d.notas, 0, 2000)
        && texto(d.foto, 0, 200000)
        && (d.foto == '' || d.foto.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+'))
        && d.fechaRegistro == request.time;
    }
  }
}
